<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="web_rbl_eintrag_list" model="ir.ui.view">
        <field name="name">web.rbl.eintrag.list</field>
        <field name="model">web.rbl.eintrag</field>
        <field name="arch" type="xml">
            <list decoration-bf="zustand == 'hochrisiko'"
                  decoration-danger="zustand in ('dauerhaft', 'hochrisiko')"
                  decoration-warning="zustand == 'gesperrt'"
                  decoration-info="zustand in ('fehlkonfiguration', 'sammler')"
                  decoration-muted="zustand == 'frei'">
                <field name="adresse"/>
                <field name="zustand"/>
                <field name="bewertung" widget="progressbar"/>
                <field name="partner_id" optional="show"/>
                <field name="treffer_anzahl" sum="Treffer gesamt"/>
                <field name="tage_auffaellig"/>
                <field name="hosts_anzahl" optional="show"/>
                <field name="hosts" optional="show"/>
                <field name="erstmals"/>
                <field name="zuletzt"/>
                <field name="gesperrt_bis"/>
                <field name="letzter_pfad" optional="show"/>
                <field name="befund" optional="hide"/>
                <button name="action_freigeben" type="object"
                        string="Freigeben" icon="fa-unlock"
                        invisible="zustand == 'frei'"/>
                <button name="action_dauerhaft_sperren" type="object"
                        string="Dauerhaft sperren" icon="fa-ban"
                        invisible="zustand == 'dauerhaft'"/>
            </list>
        </field>
    </record>

    <record id="web_rbl_eintrag_form" model="ir.ui.view">
        <field name="name">web.rbl.eintrag.form</field>
        <field name="model">web.rbl.eintrag</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_freigeben" type="object"
                            string="Freigeben" class="btn-primary"
                            invisible="zustand == 'frei'"/>
                    <button name="action_dauerhaft_sperren" type="object"
                            string="Dauerhaft sperren"
                            invisible="zustand in ('dauerhaft', 'hochrisiko')"/>
                    <button name="action_hochrisiko" type="object"
                            string="Hochrisiko"
                            invisible="zustand == 'hochrisiko'"/>
                    <button name="action_beobachten" type="object"
                            string="Nur beobachten"
                            invisible="zustand == 'beobachtet'"/>
                    <field name="zustand" widget="statusbar"
                           statusbar_visible="beobachtet,gesperrt,dauerhaft,hochrisiko"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="adresse" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="not befund">
                        <field name="befund" nolabel="1" readonly="1"/>
                        <button name="action_ticket_oeffnen" type="object"
                                class="btn-link" icon="fa-ticket"
                                string="Ticket öffnen"
                                invisible="not ticket_id"/>
                        <field name="ticket_nummer" invisible="1"/>
                        <field name="ticket_id" invisible="1"/>
                        <field name="ticket_modell" invisible="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="treffer_anzahl"/>
                            <field name="tage_auffaellig"/>
                            <field name="letzter_pfad"/>
                            <field name="partner_id"/>
                            <field name="bewertung"/>
                            <field name="bewertung_grund"/>
                        </group>
                        <group>
                            <field name="erstmals"/>
                            <field name="zuletzt"/>
                            <field name="gesperrt_bis"/>
                        </group>
                    </group>
                    <group string="Betroffene Domains">
                        <field name="hosts_anzahl"/>
                        <field name="hosts" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Notiz">
                        <field name="notiz" nolabel="1"
                               placeholder="Warum diese Adresse freigegeben oder dauerhaft gesperrt wurde…"/>
                    </group>
                    <notebook>
                        <page string="Köder" name="koeder"
                              invisible="not koeder_ids">
                            <field name="koeder_ids" readonly="1">
                                <list decoration-danger="angebissen_am">
                                    <field name="ausgelegt_am"/>
                                    <field name="art"/>
                                    <field name="pfad"/>
                                    <field name="kanarie"/>
                                    <field name="angebissen_am"/>
                                    <field name="angebissen_von"/>
                                </list>
                            </field>
                        </page>
                        <page string="Treffer" name="treffer">
                            <field name="treffer_ids" readonly="1">
                                <list>
                                    <field name="tag"/>
                                    <field name="muster"/>
                                    <field name="host"/>
                                    <field name="pfad"/>
                                    <field name="kennung" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="web_rbl_eintrag_search" model="ir.ui.view">
        <field name="name">web.rbl.eintrag.search</field>
        <field name="model">web.rbl.eintrag</field>
        <field name="arch" type="xml">
            <search>
                <field name="adresse"/>
                <field name="letzter_pfad"/>
                <field name="hosts" string="Domain"/>
                <filter name="f_gesperrt" string="Zurzeit gesperrt"
                        domain="['|', ('zustand', '=', 'dauerhaft'),
                                 '&amp;', ('zustand', '=', 'gesperrt'),
                                 ('gesperrt_bis', '&gt;', context_today().strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <filter name="f_hochrisiko" string="Hochrisiko"
                        domain="[('zustand', '=', 'hochrisiko')]"/>
                <filter name="f_dauerhaft" string="Dauerhaft"
                        domain="[('zustand', '=', 'dauerhaft')]"/>
                <filter name="f_beobachtet" string="Nur beobachtet"
                        domain="[('zustand', '=', 'beobachtet')]"/>
                <filter name="f_frei" string="Freigegeben"
                        domain="[('zustand', '=', 'frei')]"/>
                <separator/>
                <filter name="f_fehlkonfiguration" string="Fehlkonfigurationen"
                        domain="[('zustand', '=', 'fehlkonfiguration')]"
                        help="Defekte Software, die uns für etwas anderes hält. Wird nie gesperrt."/>
                <filter name="f_sammler" string="Sammler"
                        domain="[('zustand', '=', 'sammler')]"
                        help="Probiert Pflichtangaben in Schreibweisen durch, die es bei uns nicht gibt."/>
                <separator/>
                <filter name="f_hohe_bewertung" string="Bewertung ab 40"
                        domain="[('bewertung', '&gt;=', 40)]"
                        help="Ab dieser Bewertung ist die Anmeldung gesperrt."/>
                <filter name="f_wiederholt" string="An mehreren Tagen auffällig"
                        domain="[('tage_auffaellig', '&gt;', 1)]"/>
                <filter name="f_rundumschlag" string="Mehrere Domains"
                        domain="[('hosts_anzahl', '&gt;', 1)]"
                        help="Dieselbe Adresse hat mehrere unserer Webseiten angesprochen."/>
                <group>
                    <filter name="g_zustand" string="Zustand"
                            context="{'group_by': 'zustand'}"/>
                    <filter name="g_hosts" string="Domain"
                            context="{'group_by': 'hosts'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="web_rbl_eintrag_action" model="ir.actions.act_window">
        <field name="name">Sperrliste</field>
        <field name="res_model">web.rbl.eintrag</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Noch keine auffälligen Adressen.
            </p>
            <p>
                Hier erscheinen Adressen, die nach bekannten Schwachstellen
                gesucht haben — <code>.env</code>, <code>.git</code>,
                WordPress-Pfade, Verzeichniswechsel.
            </p>
        </field>
    </record>

    <record id="web_rbl_treffer_list" model="ir.ui.view">
        <field name="name">web.rbl.treffer.list</field>
        <field name="model">web.rbl.treffer</field>
        <field name="arch" type="xml">
            <list>
                <field name="tag"/>
                <field name="eintrag_id"/>
                <field name="muster"/>
                <field name="pfad"/>
            </list>
        </field>
    </record>

    <record id="web_rbl_treffer_search" model="ir.ui.view">
        <field name="name">web.rbl.treffer.search</field>
        <field name="model">web.rbl.treffer</field>
        <field name="arch" type="xml">
            <search>
                <field name="pfad"/>
                <field name="eintrag_id"/>
                <group>
                    <filter name="g_muster" string="Muster"
                            context="{'group_by': 'muster'}"/>
                    <filter name="g_tag" string="Tag"
                            context="{'group_by': 'tag'}"/>
                    <filter name="g_adresse" string="Adresse"
                            context="{'group_by': 'eintrag_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="web_rbl_treffer_action" model="ir.actions.act_window">
        <field name="name">Treffer</field>
        <field name="res_model">web.rbl.treffer</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_g_muster': 1}</field>
    </record>

</odoo>
