<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Vorsichtige Vorgaben. Das Modul beobachtet ab der
            Installation, SPERRT aber nicht: web_rbl.sperren_aktiv steht
            auf 0.

            Grund: Die Schwelle "drei verschiedene Tage" ist eine
            Annahme, solange niemand gemessen hat, wie oft dieselbe
            Adresse wiederkommt. Bei Scannern aus Rechenzentren wechselt
            sie oft täglich - dann griffe die Dauersperre nie, und man
            hätte die falsche Regel scharf geschaltet.

            Erst beobachten, dann in der Oberfläche einschalten.
        -->
        <record id="param_aktiv" model="ir.config_parameter">
            <field name="key">web_rbl.aktiv</field>
            <field name="value">1</field>
        </record>
        <record id="param_sperren_aktiv" model="ir.config_parameter">
            <field name="key">web_rbl.sperren_aktiv</field>
            <field name="value">0</field>
        </record>
        <record id="param_antwort" model="ir.config_parameter">
            <field name="key">web_rbl.antwort</field>
            <field name="value">leise</field>
        </record>
        <!--
            Der Köder ist ABGESCHALTET ausgeliefert. Er ändert das
            Verhalten nach aussen sichtbar: Statt eines 403 kommt eine
            200er-Antwort mit erfundenem Inhalt. Wer das einschaltet,
            soll es bewusst tun.
        -->
        <record id="param_koeder_aktiv" model="ir.config_parameter">
            <field name="key">web_rbl.koeder_aktiv</field>
            <field name="value">0</field>
        </record>
        <record id="param_koeder_max" model="ir.config_parameter">
            <field name="key">web_rbl.koeder_max</field>
            <field name="value">5</field>
        </record>

        <!--
            Gescheiterte Anmeldungen und Anmeldeversuche ohne gueltiges
            Sitzungsmerkmal.

            Die Schwelle 10 ist bewusst dieselbe wie Odoos eigene
            (base.login_cooldown_after). Der Unterschied liegt nicht in
            der Zahl, sondern darin, was danach passiert: Odoo laesst
            eine Minute Pause eintreten und vergisst den Stand beim
            naechsten Neustart, hier bleibt er stehen.

            Warum ueberhaupt eine Schwelle: Von neun gescheiterten
            Anmeldungen in siebzehn Tagen kamen FUENF von Kunden, die
            sich den Zugang selbst auf einem weiteren Geraet
            einrichteten und die falsche Domain eintrugen. Eine Sperre
            beim ersten Fehlversuch trifft Kunden bei der Einrichtung,
            nicht Angreifer.
        -->
        <record id="param_anmeldung_aktiv" model="ir.config_parameter">
            <field name="key">web_rbl.anmeldung_aktiv</field>
            <field name="value">1</field>
        </record>
        <record id="param_muster_anmeldung" model="ir.config_parameter">
            <field name="key">web_rbl.muster.anmeldung</field>
            <field name="value">sperren</field>
        </record>
        <record id="param_schwelle_anmeldung" model="ir.config_parameter">
            <field name="key">web_rbl.schwelle.anmeldung</field>
            <field name="value">10</field>
        </record>
        <!--
            Ab welcher Bewertung darf sich von einer Adresse niemand
            mehr anmelden? 0 schaltet es ab.

            40 statt 30 wegen eines Risikos, das in Messdaten nicht
            sichtbar wird: geteilte Adressen. Hinter einer
            Bueroadresse kann neben zwanzig Mitarbeitern ein
            befallener Rechner sitzen.
        -->
        <!--
            Gelungene Anmeldung von einer auffaelligen Adresse.
            Gemeldet wird nur, wenn die Zugangsdaten GUELTIG waren —
            ein Fehlversuch ist Laerm, ein Erfolg ist ein Befund.

            Die Schwelle ist bewusst NIEDRIG (10): Anders als bei der
            Anmeldesperre wird hier nichts verhindert, nur vermerkt.
            Ein Fehlalarm kostet einen Blick, ein uebersehener Fall
            kostet ein Konto.

            web_rbl.verdacht_melden_an: Kennungen von Benutzern, die
            eine Aufgabe dazu bekommen sollen, durch Leerzeichen
            getrennt. Leer = nur ins Protokoll.
        -->
        <record id="param_verdacht_aktiv" model="ir.config_parameter">
            <field name="key">web_rbl.verdacht_aktiv</field>
            <field name="value">1</field>
        </record>
        <record id="param_verdacht_ab_bewertung" model="ir.config_parameter">
            <field name="key">web_rbl.verdacht_ab_bewertung</field>
            <field name="value">10</field>
        </record>
        <record id="param_anmeldung_ab_bewertung" model="ir.config_parameter">
            <field name="key">web_rbl.anmeldung_ab_bewertung</field>
            <field name="value">40</field>
        </record>
        <record id="param_muster_anmeldung_bot" model="ir.config_parameter">
            <field name="key">web_rbl.muster.anmeldung_bot</field>
            <field name="value">sperren</field>
        </record>
        <record id="param_csrf_aktiv" model="ir.config_parameter">
            <field name="key">web_rbl.csrf_aktiv</field>
            <field name="value">1</field>
        </record>
        <record id="param_muster_csrf" model="ir.config_parameter">
            <field name="key">web_rbl.muster.csrf</field>
            <field name="value">sperren</field>
        </record>
        <record id="param_schwelle_csrf" model="ir.config_parameter">
            <field name="key">web_rbl.schwelle.csrf</field>
            <field name="value">10</field>
        </record>

        <!--
            Verhaltenserkennung: viele Fehlschlaege ohne Erfolge.
            Die Zahlen sind an siebzehn Tagen Echtverkehr gemessen,
            nicht geschaetzt. Siehe web_rbl_scanner.py.
        -->
        <record id="param_scanner_aktiv" model="ir.config_parameter">
            <field name="key">web_rbl.scanner_aktiv</field>
            <field name="value">1</field>
        </record>
        <record id="param_scanner_fenster" model="ir.config_parameter">
            <field name="key">web_rbl.scanner_fenster</field>
            <field name="value">300</field>
        </record>
        <record id="param_scanner_fehler" model="ir.config_parameter">
            <field name="key">web_rbl.scanner_fehler</field>
            <field name="value">20</field>
        </record>
        <record id="param_scanner_erfolge" model="ir.config_parameter">
            <field name="key">web_rbl.scanner_erfolge</field>
            <field name="value">2</field>
        </record>
        <!--
            Die Verhaltenserkennung wird MELDEND ausgeliefert, nicht
            sperrend. Sie ist die einzige Regel, die ohne ein bekanntes
            Muster auskommt, und damit die einzige, deren Fehlalarme
            man nicht vorhersehen kann. Erst ein paar Tage ansehen,
            wer darauf faellt, dann scharf schalten.
        -->
        <record id="param_muster_scanner" model="ir.config_parameter">
            <field name="key">web_rbl.muster.scanner</field>
            <field name="value">melden</field>
        </record>

        <record id="param_aufbewahrung" model="ir.config_parameter">
            <field name="key">web_rbl.treffer_aufbewahrung</field>
            <field name="value">30</field>
        </record>

        <!--
            Aus einem Befund ein Ticket machen: ABGESCHALTET
            ausgeliefert, und zwar je Muster einzeln.

            Ein Ticket ist Arbeit für einen Menschen. Ob eine
            Fehlkonfiguration diese Arbeit wert ist, hängt davon ab,
            wen sie betrifft: Bei einem Kunden mit Wartungsvertrag
            lohnt der Anruf, bei einer fremden Adresse aus dem Netz
            nicht. Deshalb keine Vorgabe, sondern eine Entscheidung.

            Einschalten je Muster:
                web_rbl.ticket.qnap         = 1
                web_rbl.ticket.autodiscover = 1
        -->
        <record id="param_ticket_modell" model="ir.config_parameter">
            <field name="key">web_rbl.ticket_modell</field>
            <field name="value">helpdesk.ticket</field>
        </record>
        <record id="param_ticket_qnap" model="ir.config_parameter">
            <field name="key">web_rbl.ticket.qnap</field>
            <field name="value">0</field>
        </record>
        <record id="param_ticket_autodiscover" model="ir.config_parameter">
            <field name="key">web_rbl.ticket.autodiscover</field>
            <field name="value">0</field>
        </record>

        <!--
            Die Freiliste fuehrt sich selbst nach. Ohne Adresse in
            web_rbl.freiliste_quelle_url tut der Lauf nichts; er ist
            deshalb gefahrlos eingeschaltet.
        -->
        <record id="cron_gegenstellen" model="ir.cron">
            <field name="name">Web RBL: VPN-Gegenstellen abgleichen</field>
            <field name="model_id" ref="model_web_rbl_freiliste"/>
            <field name="state">code</field>
            <field name="code">model._cron_gegenstellen_abgleichen()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!--
            Suchmaschinen duerfen NIE gesperrt werden. Google und
            Microsoft veroeffentlichen die Adressbereiche ihrer
            Crawler selbst; nur so laesst sich ein echter Crawler von
            einem Scanner unterscheiden, der sich Googlebot nennt.
        -->
        <record id="param_suchmaschinen_aktiv" model="ir.config_parameter">
            <field name="key">web_rbl.suchmaschinen_aktiv</field>
            <field name="value">1</field>
        </record>
        <record id="cron_suchmaschinen" model="ir.cron">
            <field name="name">Web RBL: Suchmaschinen-Adressbereiche abgleichen</field>
            <field name="model_id" ref="model_web_rbl_freiliste"/>
            <field name="state">code</field>
            <field name="code">model._cron_suchmaschinen_abgleichen()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!--
            Herkunftsland: Die GeoLite2-Datei fuehrt sich selbst nach,
            sobald ein Lizenzschluessel eingetragen ist (kostenlos,
            Konto bei MaxMind noetig). Ohne Schluessel tut der Lauf
            nichts und ist deshalb gefahrlos eingeschaltet. Der
            Schluessel gehoert in diesen Parameter und sonst nirgends
            hin, insbesondere in kein Log und keine Sicherung.
            Abgelegt wird an dem Ort, den geoip_country_db in der
            Odoo-Konfiguration nennt; das Verzeichnis muss dem
            Odoo-Benutzer gehoeren.
        -->
        <record id="param_geolite2_schluessel" model="ir.config_parameter">
            <field name="key">web_rbl.geolite2_schluessel</field>
            <field name="value"></field>
        </record>
        <record id="param_geolite2_ausgabe" model="ir.config_parameter">
            <field name="key">web_rbl.geolite2_ausgabe</field>
            <field name="value">GeoLite2-Country</field>
        </record>
        <record id="cron_geolite2" model="ir.cron">
            <field name="name">Web RBL: GeoLite2-Länderdatenbank nachführen</field>
            <field name="model_id" ref="model_web_rbl_land"/>
            <field name="state">code</field>
            <field name="code">model._cron_geolite2_abgleichen()</field>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_befunde_melden" model="ir.cron">
            <field name="name">Web RBL: Befunde als Ticket melden</field>
            <field name="model_id" ref="model_web_rbl_eintrag"/>
            <field name="state">code</field>
            <field name="code">model._cron_befunde_melden()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_fristen" model="ir.cron">
            <field name="name">Web RBL: abgelaufene Sperren zurücksetzen</field>
            <field name="model_id" ref="model_web_rbl_eintrag"/>
            <field name="state">code</field>
            <field name="code">model._cron_fristen_pruefen()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_treffer_aufraeumen" model="ir.cron">
            <field name="name">Web RBL: alte Treffer entfernen</field>
            <field name="model_id" ref="model_web_rbl_eintrag"/>
            <field name="state">code</field>
            <field name="code">model._cron_alte_treffer_loeschen()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
